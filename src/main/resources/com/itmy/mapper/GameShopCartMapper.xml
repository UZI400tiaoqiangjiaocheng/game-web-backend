<!--定义Mapper映射文件的约束和基本结构-->
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itmy.mapper.GameShopCartMapper">
    <!--根据id删除购物车中的游戏-->
    <delete id="deleteBatchIds">
        delete from gameshopcart where id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>
    <!--将游戏添加到游戏仓库中-->
    <insert id="insertGame">
        INSERT INTO gamewarehouse (user_id, game_id, create_time)
        VALUES
        <foreach collection="gameWarehouseList" item="gameWarehouse" separator=",">
            (#{gameWarehouse.userId}, #{gameWarehouse.gameId}, #{gameWarehouse.createTime})
        </foreach>
    </insert>
</mapper>